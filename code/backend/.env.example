# Gemini API key (required for cloud vision analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama local LLM (optional, fallback)
OLLAMA_BASE_URL=http://localhost:11437

# Database URL (SQLite default)
DATABASE_URL=sqlite:///./looks_optimizer.db

# Optional: Logging level
LOG_LEVEL=INFO
# System-Główny module integration key (X-Module-Key header)
MODULE_KEY=generate_a_random_secret_here

# Push reminders (plan 5.5) - generate with: cd code && python -m backend.scripts.generate_vapid_keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:twoj-adres@example.com

# Optional: hairstyle preview model (plan 4.13), daily limit
# STYLE_PREVIEW_MODEL=google/gemini-2.5-flash-image
# STYLE_PREVIEW_DAILY_LIMIT=5
