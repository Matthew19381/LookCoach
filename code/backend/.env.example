# Gemini API key (required for cloud vision analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama local LLM (optional, fallback)
OLLAMA_BASE_URL=http://localhost:11437

# Database URL (SQLite default)
DATABASE_URL=sqlite:///./looks_optimizer.db

# Optional: Logging level
LOG_LEVEL=INFO
# System-Główny module integration key (X-Module-Key header)
MODULE_KEY=generate_a_random_secret_here
